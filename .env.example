# ─────────────────────────────────────────────
# Pearls AQI Predictor — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git!
# ─────────────────────────────────────────────

# ── AQICN API ─────────────────────────────────
# Get your free token at: https://aqicn.org/data-platform/token/
AQICN_API_KEY=your_aqicn_token_here

# ── OpenWeatherMap API ────────────────────────
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Hopsworks ─────────────────────────────────
# Sign up free at: https://app.hopsworks.ai/
# Then: Account → API Keys → Create Key
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=aqi_predictor

# ── Target City ───────────────────────────────
CITY=karachi
CITY_LAT=24.8607
CITY_LON=67.0011
