# Streamlit Secrets Configuration Example
# Copy this file's contents to your Streamlit Cloud secrets settings
# 
# Dashboard: https://share.streamlit.io/
# Go to: App settings → Secrets → Paste the content below

# ── AQICN API ─────────────────────────────────
# Get your free token at: https://aqicn.org/data-platform/token/
AQICN_API_KEY = "your_aqicn_token_here"

# ── Hopsworks ─────────────────────────────────
# Sign up free at: https://app.hopsworks.ai/
# Then: Account → API Keys → Create Key
HOPSWORKS_API_KEY = "your_hopsworks_api_key_here"
HOPSWORKS_PROJECT_NAME = "aqi_predictor99"

# ── Target City ───────────────────────────────
CITY = "karachi"
CITY_LAT = "24.8607"
CITY_LON = "67.0011"

# Note: OpenMeteo is FREE and requires NO API key!
