# ─────────────────────────────────────────────────────────────
# Pearls AQI Predictor — Git Ignore
# ─────────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────────
.env
*.key
*.pem

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ──────────────────────────────────────
venv/
env/
ENV/
.venv

# ── Jupyter Notebooks ─────────────────────────────────────────
.ipynb_checkpoints
*.ipynb_checkpoints/

# ── Data & Models ─────────────────────────────────────────────
data/backfill/*.csv
data/backfill/*.parquet
data/raw/
data/processed/
models/*.pkl
models/*.h5
models/*.pb
*.joblib

# ── IDE & Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Temporary Files ───────────────────────────────────────────
*.tmp
*.bak
.cache/
